# Local workstation (macOS / Homebrew) specifics
export PKCS11_MODULE="/opt/homebrew/opt/softhsm/lib/softhsm/libsofthsm2.so"

# The PINs to use for the token and keys. Remember to change these in a real application.
export HSM_SO_PIN="change-me"
export HSM_PIN="change-me-too"

# The label to use for the token and keys. You can change this label, but use
# only alphanumeric characters (a-z, A-Z, 0-9). Other characters, such as ".",
# can break the label checks in setup.sh.
export HSM_TOKEN_LABEL="example"

# The label of the AES-256 key in the token. `setup.sh` creates the key with
# this label, and the integration tests use it. Use the same characters as for
# the token label, plus "-".
export AES_KEY_LABEL="example-aes"

# The label of the exportable EC P-256 key pair. `setup.sh` creates it. Its
# private key is extractable, so the `wrap` command can wrap it with the AES
# key. It is still sensitive, so its value never leaves the HSM in plain form.
# Use the same characters as for the AES key label.
export EXPORTABLE_KEY_LABEL="example-exportable"

# The service address and port to bind to
export HSM_SIGNING_SERVICE_HOST="127.0.0.1"
export HSM_SIGNING_SERVICE_PORT="8080"

# How many seconds the server waits for running requests after SIGINT or
# SIGTERM. The server exits with code 1 if requests are still running after
# this time. Use a whole number of 1 or more.
export HSM_SIGNING_SERVICE_SHUTDOWN_TIMEOUT_SECS="30"

# How many HSM sessions the server keeps in its session pool. Use a whole
# number of 1 or more. If you do not set it, the server uses one session.
export HSM_SIGNING_SERVICE_SESSION_POOL_SIZE="10"

# How many milliseconds a request waits for a free session of the session pool.
# The request fails if no session is free after this time. The pool also uses
# this time to open its sessions at start. Use a whole number. The value 0 is
# not valid: the server does not start. The default is 500ms.
export HSM_SIGNING_SERVICE_POOL_CONNECTION_TIMEOUT_MS="500"

# How many requests can wait for a free session, in addition to the requests
# that use a session. The server answers more requests at once with 503 and a
# Retry-After header. Use a whole number of 0 or more. With 0, no request waits.
# The default is 20.
export HSM_SIGNING_SERVICE_MAX_QUEUE="20"
